# =============================================================================
# Riya.lk — environment variables
# Copy this file to `.env` and fill in the values:  cp .env.example .env
# =============================================================================

# ----------------------------------------------------------------- Database
# PostgreSQL connection string.
# Tip: no Postgres installed? Run `npx prisma dev` and paste the URL it prints.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/riya?schema=public"
# Max database connections per server instance (default 10).
# Set to 1 when using `npx prisma dev` — it only handles one connection at a time.
DATABASE_POOL_MAX=""

# ----------------------------------------------------------------- Site
# Public base URL — used for canonical links, sitemap, Open Graph and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ----------------------------------------------------------------- Auth (NextAuth v4)
NEXTAUTH_URL="http://localhost:3000"
# Long random string. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google sign-in (optional — the button is hidden when these are empty).
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI:  <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------------------------- Admin panel
# Secret used to sign admin session cookies. Use a DIFFERENT value from NEXTAUTH_SECRET.
ADMIN_JWT_SECRET=""

# ----------------------------------------------------------------- Images (Cloudinary)
# Required in production. In development, uploads fall back to /public/uploads
# when these are empty.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ----------------------------------------------------------------- Phone verification (OTP)
# Secret used to hash one-time codes.
OTP_SECRET=""
# console  → codes are printed in the server log (development only)
# notifylk → https://notify.lk
# textlk   → https://text.lk
SMS_PROVIDER="console"

NOTIFYLK_USER_ID=""
NOTIFYLK_API_KEY=""
NOTIFYLK_SENDER_ID=""

TEXTLK_API_TOKEN=""
TEXTLK_SENDER_ID=""

# ----------------------------------------------------------------- Seeding
# "true" adds a demo seller (demo@riya.lk / demo12345) and 16 sample ads.
SEED_DEMO_DATA="false"
